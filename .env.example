# Copy this file to .env (gitignored).  The harness loads it automatically.
# Set the variable named by api_key_env in config.toml; shell exports win.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local OpenAI-compatible servers usually need no key.  To use a custom config:
# HARNESS_CONFIG=config.toml
